# Environment Variables Template
# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/mousetoclick?schema=public"

# Admin Dashboard Access
ADMIN_PASSWORD="change_this_to_a_secure_admin_password"

# Email Notifications (SMTP / Resend / SendGrid)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASS="your-smtp-password"
NOTIFICATION_TO_EMAIL="admin@mousetoclick.com"

# Next.js Public
NEXT_PUBLIC_SITE_URL="https://mousetoclick.com"

